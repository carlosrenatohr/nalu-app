# Nalu backend — plantilla de variables locales
# Copia a .env y rellena con tus claves (NUNCA commitees .env).
#
# Preferido en producción: Jev vía Vercel AI Gateway (Zen limita por
# origen las IPs de Cloudflare Workers; ver docs/JEV.md).
#AI_GATEWAY_API_KEY=vck_tu-clave-del-ai-gateway
#AI_GATEWAY_MODEL=typesafe-ai/jev
#
# Respaldo / desarrollo local: Jev directo vía OpenCode Zen.
OPENCODE_ZEN_API_KEY=tu-api-key-de-opencode-zen
#ZEN_MODEL=jev-1.13-free
#ZEN_ENDPOINT=https://opencode.ai/zen/v1/systemone
AI_GATEWAY_API_KEY=vck_
